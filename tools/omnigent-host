#!/bin/bash
# Relative wrapper for portable Omnigent Host agent.
# Usage: omnigent-host [OPTIONS] [SERVER_URL]
set -euo pipefail

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
drive_shared=
if [ -f "$script_dir/../launch/lib/drive.sh" ]; then
    drive_shared=$(CDPATH='' cd -- "$script_dir/.." && pwd -P)
elif [ -f "$script_dir/../../AI-SHARED/launch/lib/drive.sh" ]; then
    drive_shared=$(CDPATH='' cd -- "$script_dir/../../AI-SHARED" && pwd -P)
elif [ -f "$script_dir/launch/lib/drive.sh" ]; then
    drive_shared="$script_dir"
fi

if [ -z "$drive_shared" ] || [ ! -f "$drive_shared/launch/lib/drive.sh" ]; then
    echo "Cannot resolve AI-SHARED volume relative to $script_dir" >&2
    exit 1
fi

drive_os=$(uname -s | tr '[:upper:]' '[:lower:]')
case "$drive_os" in
    linux|darwin) ;;
    *) echo "Unsupported operating system: $drive_os (Linux and macOS supported)" >&2; exit 1 ;;
esac

# Source drive and omnigent helpers
# shellcheck source=launch/lib/drive.sh
. "$drive_shared/launch/lib/drive.sh"
# shellcheck source=launch/lib/session.sh
. "$drive_shared/launch/lib/session.sh"
# shellcheck source=launch/lib/omnigent-host.sh
. "$drive_shared/launch/lib/omnigent-host.sh"

drive_native=$(drive_discover "$drive_os" "$drive_shared") || exit 1
drive_target="$drive_os-$(drive_arch)" || exit 1
drive_entry="$drive_shared/launch/$drive_os.sh"

# Setup drive environment (HOME, TMPDIR, CODEX_HOME, CLAUDE_CONFIG_DIR, etc.)
drive_environment "$drive_shared" "$drive_native" "$drive_target" || exit 1

drive_omnigent "$@"

